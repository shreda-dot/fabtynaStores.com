# Fabtyna Stores — API environment template.
#
# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is git-ignored; this example is not. Never commit real credentials.

# --- Database (Neon Postgres) ----------------------------------------------
# Optional pooled Neon endpoint. The API runtime and migrations use DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Schema / migration connection: the DIRECT Neon endpoint (no pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional pool size for the API (1-10, default 10).
DB_POOL_MAX=10

# --- Authentication and web origin ----------------------------------------
# Exact browser origin; production requires HTTPS and an explicit value.
WEB_ORIGIN=http://localhost:3000
# Production requires an explicit host; development defaults to 127.0.0.1.
HOST=127.0.0.1
TRUST_PROXY=false
# Optional cookie domain. When omitted in production, the __Host- cookie prefix is used.
COOKIE_DOMAIN=
SESSION_IDLE_TIMEOUT_HOURS=12
SESSION_ABSOLUTE_TIMEOUT_DAYS=7

# --- Test database (used only by the API test suite) -----------------------
# Must point at a *different* database whose name contains "test"; the tests
# refuse to run otherwise.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/fabtyna_test?sslmode=require"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/fabtyna_test?sslmode=require"

# --- HTTP ------------------------------------------------------------------
# Optional; defaults to 3001.
PORT="3001"

# --- Transaction timeouts (optional, milliseconds, 100-600000) -------------
# API_TX_TIMEOUT_MS=20000
# API_TX_MAX_WAIT_MS=10000
# API_LOCK_TIMEOUT_MS=15000   # must be below API_TX_TIMEOUT_MS

# Maximum inclusive date range for list and statement filters (default 366).
# API_MAX_DATE_RANGE_DAYS=366

# --- Admin seed (pnpm --filter @fabtyna/api db:seed:admin) -----------------
# Email of the first admin account. Stored lower-cased and trimmed.
ADMIN_EMAIL="owner@example.com"
# Argon2id hash of that account's password. Generate it with:
#   pnpm --filter @fabtyna/api hash-password
# Paste ONLY the `$argon2id$...` line that command prints. Never store the
# plaintext password itself.
ADMIN_PASSWORD_HASH="$argon2id$v=19$m=65536,t=3,p=1$PLACEHOLDER_SALT$PLACEHOLDER_DIGEST"
