// Fabtyna Stores — canonical database schema.
//
// Source of truth for this schema is the running application, not the original
// plan document: `packages/shared/src/domain/types.ts` (domain model) plus the
// Zod DTOs in `packages/shared/src/schemas/**` and the 23 collections in
// `apps/web/lib/api/mock-store.ts`.
//
// Conventions
//   * All money is integer kobo (`BigInt`). DTOs expose them as integer strings.
//   * All timestamps are `DateTime` (timestamptz). Business dates that the app
//     stores as a `YYYY-MM-DD` string (a Lagos business date produced by
//     `getLagosBusinessDate()`) are stored as `String` so they round-trip
//     without a timezone shift.
//   * Ledgers (stock movements, customer/supplier/account ledgers, loan ledger,
//     payments, cash snapshots) are append-only. Corrections are new reversal
//     rows linked through `reversesEntryId`.
//   * Sign conventions, source exclusivity, reversal uniqueness, immutability,
//     value sanity and the credit/lifecycle rules are enforced by hand-written
//     SQL that lives *inside* the Prisma migration history
//     (`apps/api/prisma/migrations/**`). Prisma cannot express CHECK
//     constraints, partial unique indexes, triggers or status transitions, so
//     those are authored by hand in the migration folders.
//   * THE MIGRATIONS ARE THE SINGLE SOURCE OF TRUTH for the database. There is
//     no `sql-drafts/` folder: every constraint, index and trigger that used to
//     live there has been folded into a named migration. See
//     `docs/backend-schema.md` for the full inventory.
//
// Deliberate additions beyond the current frontend model (see audit report):
//   * `Account` / `AccountLedgerEntry` / `AccountType` and the `accountId`
//     column on payments — retained by explicit decision.
//   * Some ledger rows carry nullable source columns whose target entity is not
//     modelled yet (`customerPaymentId`, `saleReturnId`, `customerRefundId`,
//     `otherIncomeId`, `accountTransferId`, `returnLineId`). They are kept as
//     plain nullable columns, without relations, so the persisted shape matches
//     the shared DTOs.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// The connection string is deliberately NOT declared in this datasource block.
// Prisma 7 resolves it per command: schema/migration commands read
// `DIRECT_URL` from `prisma.config.ts` (direct Neon connection, bypassing the
// pooler), while the runtime client gets the pooled `DATABASE_URL` through its
// driver adapter (see `src/lib/prisma.ts`).
datasource db {
  provider = "postgresql"
}

// =====================================================================
// Enums — values mirror `packages/shared/src/domain/types.ts`
// =====================================================================

enum ProductCategory {
  BEER
  SOFT_DRINK
  OTHER
}

/// How a product may be sold. `BOTH` is valid on a product; a *sale* must be
/// RETAIL or WHOLESALE only (enforced in the sales check constraint).
enum SaleChannel {
  RETAIL
  WHOLESALE
  BOTH
}

enum Unit {
  UNIT
  PACK
}

enum StockLocation {
  WAREHOUSE
  RETAIL_SHELF
  MARKET
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum TransferDirection {
  IN
  OUT
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  VOIDED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
}

/// How money physically left/entered the business (app value set).
enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

enum CustomerType {
  WHOLESALE
  RETAIL
}

enum CustomerLedgerEntryType {
  SALE
  PAYMENT
  RETURN
  CUSTOMER_REFUND
  ADJUSTMENT
}

enum SupplierLedgerEntryType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
}

/// Retained for the account subsystem. Not present in the frontend model yet.
enum AccountType {
  CASH
  BANK
  POS
}

/// Values mirror `packages/shared/src/domain/types.ts`. The four values added
/// by migration `20261019…_account_entry_type_values` are appended at the end
/// because Postgres `ALTER TYPE … ADD VALUE` can only append: declaring them
/// in the middle would make Prisma emit an enum-rebuild instead of a plain
/// `ADD VALUE`. Enum order carries no meaning.
enum AccountEntryType {
  SALE_PAYMENT
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE
  CUSTOMER_REFUND
  TRANSFER_IN
  TRANSFER_OUT
  OWNER_CAPITAL
  OWNER_DRAWING
  OTHER_INCOME
  BANK_OR_POS_CHARGE
  ADJUSTMENT
  PURCHASE_PAYMENT
  OPENING_BALANCE
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
}

enum StockAdjustmentStatus {
  COMPLETED
  VOIDED
}

enum LoanLedgerEntryType {
  DISBURSEMENT
  CHARGE
  REPAYMENT
}

/// Who an admin user is. **NOT ENFORCED ANYWHERE YET.** There is no
/// authorization layer: nothing reads this column, so every account still has
/// full access. It exists so that when roles are wired up there is a value to
/// read. `OWNER` is the first account created by `db:seed:admin`; `STAFF` is
/// anyone added later with `--additional`, and the column default.
enum AdminRole {
  OWNER
  STAFF
}

// =====================================================================
// Identity and audit
// =====================================================================

model AdminUser {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  /// Not enforced anywhere yet — see the `AdminRole` comment above.
  role             AdminRole         @default(STAFF)
  /// Accounts are deactivated, never deleted: `Purchase`, `Sale`,
  /// `StockTransfer` and `StockAdjustment` reference this table with
  /// `onDelete: Restrict`, so a hard delete would strip the actor from history.
  isActive         Boolean           @default(true)
  /// Last successful sign-in. Null until sign-in is implemented. Stored as
  /// `timestamptz` per the documented convention
  /// (`docs/backend-schema.md` §1); note it is the *only* `timestamptz` column
  /// so far — every other timestamp column is `timestamp(3)`.
  lastLoginAt      DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchases        Purchase[]
  sales            Sale[]
  stockTransfers   StockTransfer[]
  stockAdjustments StockAdjustment[]
  auditLogs        AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  metadata   Json?
  occurredAt DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("audit_logs")
}

/// Replay protection for retried POST requests (migration
/// `20261020000200_idempotency_keys`). Operational, not a ledger: a row is
/// claimed inside the request's own transaction, updated once with the response,
/// and purged after `expiresAt`. Unique on (key, route) for now; an `actorId`
/// joins the unique key when login exists.
model IdempotencyKey {
  id             String   @id @default(cuid())
  key            String
  route          String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([key, route])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// =====================================================================
// Catalogue and parties
// =====================================================================

model Product {
  id                 String                @id @default(cuid())
  name               String
  sku                String?
  category           ProductCategory
  packName           String                @default("crate")
  unitsPerPack       Int
  /// Which shelf/price list this product is sellable from.
  saleChannel        SaleChannel           @default(BOTH)
  retailPriceKobo    BigInt
  wholesalePriceKobo BigInt
  averageCostKobo    BigInt                @default(0)
  reorderLevelUnits  Int                   @default(0)
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  purchaseLines      PurchaseLine[]
  saleLines          SaleLine[]
  stockMovements     StockMovement[]
  stockBalances      StockBalance[]
  transferLines      StockTransferLine[]
  adjustmentLines    StockAdjustmentLine[]

  // Partial unique index on (sku) WHERE deletedAt IS NULL and the
  // `sku = upper(trim(sku))` CHECK live in the hand-written SQL migrations;
  // Prisma cannot express either here.
  @@index([sku])
  @@index([name])
  @@index([deletedAt])
  @@map("products")
}

model Supplier {
  id            String                @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  purchases     Purchase[]
  payments      SupplierPayment[]
  ledgerEntries SupplierLedgerEntry[]

  @@index([name])
  @@index([deletedAt])
  @@map("suppliers")
}

model Customer {
  id              String                @id @default(cuid())
  name            String
  type            CustomerType          @default(RETAIL)
  creditLimitKobo BigInt                @default(0)
  phone           String?
  email           String?
  address         String?
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sales           Sale[]
  ledgerEntries   CustomerLedgerEntry[]

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

// =====================================================================
// Purchases (supplier credit / payables)
// =====================================================================

model Purchase {
  id                    String                @id @default(cuid())
  supplierId            String?
  createdById           String
  status                PurchaseStatus        @default(DRAFT)
  reference             String?               @unique
  notes                 String?
  totalKobo             BigInt                @default(0)
  /// Amount already paid to the supplier. Denormalised from `SupplierPayment`
  /// rows for cheap list rendering. No trigger keeps this in step: the payment
  /// service owns it and the drift-audit query in
  /// `20261017000500_value_checks` proves there is no gap.
  paidKobo              BigInt                @default(0)
  /// Lagos business date (YYYY-MM-DD) the balance becomes overdue. Null = none.
  dueDate               String?
  purchasedAt           DateTime              @default(now())
  receivedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  supplier              Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy             AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines                 PurchaseLine[]
  payments              SupplierPayment[]
  supplierLedgerEntries SupplierLedgerEntry[]
  accountLedgerEntries  AccountLedgerEntry[]

  // Hand-written SQL, not Prisma constraints:
  //   * `paidKobo <= totalKobo` (migration `20261017000500_value_checks`);
  //   * `paidKobo < totalKobo` requires `supplierId IS NOT NULL` (migration
  //     `20261017000700_sale_purchase_rules`), mirroring createPurchase().
  @@index([purchasedAt])
  @@index([supplierId, purchasedAt])
  @@index([dueDate])
  @@map("purchases")
}

model PurchaseLine {
  id                   String          @id @default(cuid())
  purchaseId           String
  productId            String
  unit                 Unit
  /// Quantity in `unit` (PACK allows a fraction, e.g. 0.5 of a crate).
  /// `quantityUnits` stays the authoritative INTEGER base-unit count.
  quantity             Decimal         @db.Decimal(12, 4)
  unitsPerPackSnapshot Int
  quantityUnits        Int
  unitCostKobo         BigInt
  lineTotalKobo        BigInt
  purchase             Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]

  @@index([productId])
  @@map("purchase_lines")
}

/// Immutable record of one payment made to a supplier. Mirrors `SalePayment`.
/// The matching (negative) `SupplierLedgerEntry` references this row through
/// `supplierPaymentId`, keeping the ledger source-exclusivity invariant intact.
model SupplierPayment {
  id                   String                @id @default(cuid())
  supplierId           String
  purchaseId           String
  accountId            String
  method               PaymentMethod
  amountKobo           BigInt
  note                 String?
  paidAt               DateTime              @default(now())
  createdAt            DateTime              @default(now())
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase             Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntries        SupplierLedgerEntry[]
  accountLedgerEntries AccountLedgerEntry[]

  @@index([supplierId, paidAt])
  @@index([purchaseId, paidAt])
  @@index([accountId, paidAt])
  @@map("supplier_payments")
}

/// Reversal convention: keep type and source ids, negate the amount exactly,
/// and set `reversesEntryId` to the original. A row can be reversed once only;
/// a reversal cannot itself be reversed. Signed: PURCHASE +, PAYMENT -.
model SupplierLedgerEntry {
  id                String                  @id @default(cuid())
  supplierId        String
  type              SupplierLedgerEntryType
  amountKobo        BigInt
  purchaseId        String?
  supplierPaymentId String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime                @default(now())
  supplier          Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase          Purchase?               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplierPayment   SupplierPayment?        @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  reversesEntry     SupplierLedgerEntry?    @relation("SupplierLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        SupplierLedgerEntry[]   @relation("SupplierLedgerReversals")

  @@index([supplierId, occurredAt])
  @@index([purchaseId])
  @@index([supplierPaymentId])
  @@index([reversesEntryId])
  @@map("supplier_ledger_entries")
}

// =====================================================================
// Stock
// =====================================================================

model StockTransfer {
  id            String              @id @default(cuid())
  createdById   String
  from          StockLocation
  to            StockLocation
  reason        String?
  reference     String?             @unique
  transferredAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  createdBy     AdminUser           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         StockTransferLine[]

  // `from <> to` is a hand-written CHECK constraint.
  @@index([transferredAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id            String             @id @default(cuid())
  transferId    String
  productId     String
  quantityUnits Int
  transfer      StockTransfer      @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  movementLegs  StockTransferLeg[]

  @@index([productId])
  @@map("stock_transfer_lines")
}

/// A transfer has separate IN and OUT legs so each immutable stock movement has
/// exactly one uniquely attributable source row.
model StockTransferLeg {
  id             String            @id @default(cuid())
  transferLineId String
  location       StockLocation
  direction      TransferDirection
  transferLine   StockTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([transferLineId, direction])
  @@map("stock_transfer_legs")
}

model StockAdjustment {
  id          String                @id @default(cuid())
  createdById String
  reason      String
  status      StockAdjustmentStatus @default(COMPLETED)
  adjustedAt  DateTime              @default(now())
  createdAt   DateTime              @default(now())
  createdBy   AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines       StockAdjustmentLine[]

  @@index([adjustedAt])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                 String          @id @default(cuid())
  adjustmentId       String
  productId          String
  location           StockLocation
  quantityDeltaUnits Int
  unitCostKobo       BigInt
  reason             String?
  adjustment         StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements     StockMovement[]

  @@index([productId, location])
  @@map("stock_adjustment_lines")
}

/// One immutable stock movement. Exactly one source column must be set
/// (`returnLineId` is reserved — no return entity is modelled yet, so it is a
/// plain column without a relation). Never-negative stock is enforced in the
/// service with a row lock; single-source and sign rules are SQL CHECKs.
model StockMovement {
  id               String               @id @default(cuid())
  productId        String
  location         StockLocation
  type             StockMovementType
  quantityUnits    Int
  unitCostKobo     BigInt
  purchaseLineId   String?
  saleLineId       String?
  transferLegId    String?
  adjustmentLineId String?
  returnLineId     String?
  reversesEntryId  String?
  occurredAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseLine     PurchaseLine?        @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  saleLine         SaleLine?            @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  transferLeg      StockTransferLeg?    @relation(fields: [transferLegId], references: [id], onDelete: Restrict)
  adjustmentLine   StockAdjustmentLine? @relation(fields: [adjustmentLineId], references: [id], onDelete: Restrict)
  reversesEntry    StockMovement?       @relation("StockMovementReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy       StockMovement[]      @relation("StockMovementReversals")

  @@index([productId, location, occurredAt])
  @@index([type, occurredAt])
  @@index([purchaseLineId])
  @@index([saleLineId])
  @@index([transferLegId])
  @@index([adjustmentLineId])
  @@index([returnLineId])
  @@index([reversesEntryId])
  @@map("stock_movements")
}

/// Running total of base units per product and location, derived from
/// `stock_movements` by an AFTER INSERT trigger (migration
/// `20261017100000_stock_balances`). It is what makes the database itself the
/// arbiter of "stock never goes below zero": a movement that would take a
/// balance negative aborts on `ck_stock_balances_nonnegative`.
///
/// Never write this table from the application. `trg_stock_balances_guard`
/// rejects any write that did not come from the trigger, and the only legal
/// mutation is `INSERT ... ON CONFLICT DO UPDATE`, which takes a row lock so
/// two concurrent sales cannot both read the same stale balance.
model StockBalance {
  productId     String
  location      StockLocation
  quantityUnits Int           @default(0)
  /// Set by the trigger on every applied movement, not by `@updatedAt`.
  updatedAt     DateTime      @default(now())
  /// `onUpdate: NoAction` is deliberate: the hand-written FK in migration
  /// `20261017100000_stock_balances` declares only `ON DELETE RESTRICT`, which
  /// is `NO ACTION` on update. Declaring Prisma's default (`Cascade`) here
  /// would make `prisma migrate dev` emit a migration that rewrites the
  /// constraint. `NO ACTION` is safe: primary keys are never updated.
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_stock_balances_product")

  // `ck_stock_balances_nonnegative` is hand-written SQL.
  @@id([productId, location])
  @@map("stock_balances")
}

// =====================================================================
// Sales
// =====================================================================

model Sale {
  id                    String                @id @default(cuid())
  createdById           String
  customerId            String?
  /// Optional denormalised display name for ad-hoc customers. The application
  /// never populates it today — every create path (sales/new, the retail-debtor
  /// dialog) sends `null` and uses `customerId` instead. Kept nullable and
  /// untouched for the shared DTO shape.
  customerName          String?
  channel               SaleChannel
  status                SaleStatus            @default(DRAFT)
  reference             String?               @unique
  notes                 String?
  totalKobo             BigInt                @default(0)
  /// Amount already received. Denormalised from `SalePayment` rows.
  paidKobo              BigInt                @default(0)
  soldAt                DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdBy             AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines                 SaleLine[]
  payments              SalePayment[]
  customerLedgerEntries CustomerLedgerEntry[]

  // Hand-written SQL, not Prisma constraints:
  //   * `channel <> 'BOTH'` and `paidKobo <= totalKobo` (migration
  //     `20261017000500_value_checks`);
  //   * `paidKobo < totalKobo` requires `customerId IS NOT NULL` (migration
  //     `20261017000700_sale_purchase_rules`), mirroring
  //     validateCompletedSalePayment();
  //   * `VOIDED` is terminal and a COMPLETED sale cannot return to DRAFT
  //     (same migration, enforced by a BEFORE UPDATE trigger).
  @@index([soldAt])
  @@index([customerId, soldAt])
  @@map("sales")
}

model SaleLine {
  id                   String          @id @default(cuid())
  saleId               String
  productId            String
  location             StockLocation
  unit                 Unit
  /// Quantity in `unit`. A PACK line may be fractional (a wholesale customer
  /// can buy half a crate); `quantityUnits` stays the authoritative INTEGER
  /// base-unit count, and `ck_sale_lines_units_consistent` requires the
  /// fraction to resolve to a whole number of units.
  quantity             Decimal         @db.Decimal(12, 4)
  unitsPerPackSnapshot Int
  quantityUnits        Int
  unitPriceKobo        BigInt
  costPerUnitKobo      BigInt
  lineTotalKobo        BigInt
  sale                 Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]

  @@index([productId, saleId])
  @@map("sale_lines")
}

/// Immutable sale payment. `accountId` is mandatory: every payment lands in a
/// named account. There is deliberately no `method` column — the destination
/// account's type (CASH / BANK / POS) already records how the money arrived.
model SalePayment {
  id                    String                @id @default(cuid())
  saleId                String
  accountId             String
  amountKobo            BigInt
  paidAt                DateTime              @default(now())
  createdAt             DateTime              @default(now())
  sale                  Sale                  @relation(fields: [saleId], references: [id], onDelete: Restrict)
  account               Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customerLedgerEntries CustomerLedgerEntry[]
  accountLedgerEntries  AccountLedgerEntry[]

  @@index([saleId, paidAt])
  @@index([accountId, paidAt])
  @@map("sale_payments")
}

/// Reversal convention as for the other ledgers. Signed: SALE +, PAYMENT -,
/// RETURN -, CUSTOMER_REFUND +. Debtor aging applies payments to the oldest
/// unpaid sales at query time; there is no payment-allocation table.
///
/// `customerPaymentId`, `saleReturnId` and `customerRefundId` are reserved for
/// entities that are not modelled yet; they are plain nullable columns.
model CustomerLedgerEntry {
  id                String                  @id @default(cuid())
  customerId        String
  type              CustomerLedgerEntryType
  amountKobo        BigInt
  saleId            String?
  salePaymentId     String?
  customerPaymentId String?
  saleReturnId      String?
  customerRefundId  String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime                @default(now())
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale              Sale?                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  salePayment       SalePayment?            @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  reversesEntry     CustomerLedgerEntry?    @relation("CustomerLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        CustomerLedgerEntry[]   @relation("CustomerLedgerReversals")

  @@index([customerId, occurredAt])
  @@index([saleId])
  @@index([salePaymentId])
  @@index([customerPaymentId])
  @@index([saleReturnId])
  @@index([customerRefundId])
  @@index([reversesEntryId])
  @@map("customer_ledger_entries")
}

// =====================================================================
// Accounts (ledger-backed money subsystem)
// =====================================================================

/// An account is retired by deactivation, never by deletion: the ledger that
/// references it has to keep its meaning. `isActive` and `deactivatedAt` move
/// together (`ck_accounts_deactivation_pair`), and an account may only be
/// deactivated while its `account_balances` row is exactly zero
/// (`trg_account_deactivation_guard`).
model Account {
  id               String               @id @default(cuid())
  name             String
  type             AccountType
  isActive         Boolean              @default(true)
  deactivatedAt    DateTime?
  note             String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  entries          AccountLedgerEntry[]
  salePayments     SalePayment[]
  supplierPayments SupplierPayment[]
  transfersFrom    AccountTransfer[]    @relation("AccountTransfersFrom")
  transfersTo      AccountTransfer[]    @relation("AccountTransfersTo")
  balance          AccountBalance?

  @@index([isActive, type])
  @@map("accounts")
}

/// Reversal convention as for the other ledgers. Signed: money in +, money out
/// minus. `customerPaymentId`, `otherIncomeId` and `customerRefundId` are
/// reserved for entities not modelled yet (plain nullable columns).
///
/// The four "how did money move" types added by migration
/// `20261019000100_account_ledger_sources` — `PURCHASE_PAYMENT`,
/// `OPENING_BALANCE`, `LOAN_DISBURSEMENT`, `LOAN_REPAYMENT` — each carry their
/// own source column, enforced by `ck_account_ledger_single_source` and
/// `trg_account_ledger_source`.
model AccountLedgerEntry {
  id                String               @id @default(cuid())
  accountId         String
  type              AccountEntryType
  amountKobo        BigInt
  salePaymentId     String?
  customerPaymentId String?
  supplierPaymentId String?
  purchaseId        String?
  expenseId         String?
  otherIncomeId     String?
  accountTransferId String?
  customerRefundId  String?
  loanId            String?
  loanRepaymentId   String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime             @default(now())
  account           Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  salePayment       SalePayment?         @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  supplierPayment   SupplierPayment?     @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  purchase          Purchase?            @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  expense           Expense?             @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  accountTransfer   AccountTransfer?     @relation(fields: [accountTransferId], references: [id], onDelete: Restrict)
  loan              Loan?                @relation(fields: [loanId], references: [id], onDelete: Restrict)
  loanRepayment     LoanRepayment?       @relation(fields: [loanRepaymentId], references: [id], onDelete: Restrict)
  reversesEntry     AccountLedgerEntry?  @relation("AccountLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        AccountLedgerEntry[] @relation("AccountLedgerReversals")

  @@index([accountId, occurredAt])
  @@index([salePaymentId])
  @@index([customerPaymentId])
  @@index([supplierPaymentId])
  @@index([purchaseId])
  @@index([expenseId])
  @@index([otherIncomeId])
  @@index([accountTransferId])
  @@index([customerRefundId])
  @@index([loanId])
  @@index([loanRepaymentId])
  @@index([reversesEntryId])
  @@map("account_ledger_entries")
}

/// The document behind one TRANSFER_IN / TRANSFER_OUT ledger pair. Append-only:
/// `trg_account_transfer_immutable` rejects any UPDATE or DELETE. The pair is
/// keyed by `ux_account_ledger_transfer_type_active`, which allows exactly one
/// live entry of each direction per transfer.
model AccountTransfer {
  id            String               @id @default(cuid())
  fromAccountId String
  toAccountId   String
  amountKobo    BigInt
  note          String?
  occurredAt    DateTime             @default(now())
  createdAt     DateTime             @default(now())
  fromAccount   Account              @relation("AccountTransfersFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account              @relation("AccountTransfersTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  ledgerEntries AccountLedgerEntry[]

  // `ck_account_transfers_amount_positive` and
  // `ck_account_transfers_different_accounts` are hand-written SQL.
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([occurredAt])
  @@map("account_transfers")
}

/// Running total of `amountKobo` per account, derived from
/// `account_ledger_entries` by an AFTER INSERT trigger (migration
/// `20261019000100_account_ledger_sources`). It is what makes the database
/// itself the arbiter of "money never goes below zero": an entry that would
/// take a balance negative aborts on `ck_account_balances_nonnegative`.
///
/// Never write this table from the application. `trg_account_balances_guard`
/// rejects any write that did not come from the trigger. The maintainer
/// UPDATEs an existing row first, inserting only when none exists and retrying
/// on a concurrent first insert. `INSERT ... ON CONFLICT DO UPDATE` is unsafe
/// here because PostgreSQL checks the proposed row's non-negative CHECK before
/// conflict arbitration, which can reject a valid merged balance.
model AccountBalance {
  accountId   String   @id
  balanceKobo BigInt   @default(0)
  /// Set by the trigger on every applied entry, not by `@updatedAt`.
  updatedAt   DateTime @default(now())
  /// `onUpdate: NoAction` is deliberate: the hand-written FK in migration
  /// `20261019000100_account_ledger_sources` declares only
  /// `ON DELETE RESTRICT`, which is `NO ACTION` on update. Declaring Prisma's
  /// default (`Cascade`) would make `prisma migrate dev` emit a migration that
  /// rewrites the constraint. `NO ACTION` is safe: primary keys are never
  /// updated.
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  // `ck_account_balances_nonnegative` is hand-written SQL.
  @@map("account_balances")
}

// =====================================================================
// Expenses
// =====================================================================

/// `channel` is the shelf the cost belongs to; `BOTH` expenses are split
/// between retail and wholesale in daily-total reports. `loanRepaymentId` is
/// set when the row was generated by a loan repayment's interest portion. The
/// relation is `map`ped onto the hand-written constraint name
/// `fk_expenses_loan_repayment` (migration `20261017000600`) so Prisma manages
/// it without renaming it.
model Expense {
  id              String               @id @default(cuid())
  channel         SaleChannel
  categoryId      String
  description     String
  amountKobo      BigInt
  expenseDate     DateTime
  loanRepaymentId String?              @unique
  /// An expense that has moved money out of an account is never edited into a
  /// different amount: it is voided, the account entry is reversed, and the
  /// row leaves the reports. `voidReason` is required exactly when `voidedAt`
  /// is set (`ck_expenses_void_pair`, mirroring `validateExpenseVoidFields`).
  voidedAt        DateTime?
  voidReason      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  category        ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_expenses_category")
  ledgerEntries   AccountLedgerEntry[]
  loanRepayment   LoanRepayment?       @relation(fields: [loanRepaymentId], references: [id], onDelete: Restrict, map: "fk_expenses_loan_repayment")

  // `amountKobo > 0` is a hand-written CHECK constraint.
  @@index([expenseDate])
  @@index([channel, expenseDate])
  @@index([categoryId, expenseDate], map: "expenses_categoryId_expenseDate_idx")
  @@map("expenses")
}

model ExpenseCategory {
  id            String    @id @default(cuid())
  name          String
  normalizedKey String    @unique(map: "expense_categories_normalizedKey_key")
  code          String?   @unique(map: "expense_categories_code_key")
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  expenses      Expense[]

  @@map("expense_categories")
}

// =====================================================================
// Loans
// =====================================================================

model Loan {
  id                   String               @id @default(cuid())
  lenderName           String
  principalKobo        BigInt
  /// Total interest/fee agreed up front. May be zero.
  agreedInterestKobo   BigInt               @default(0)
  disbursedAt          DateTime             @default(now())
  /// Lagos business date (YYYY-MM-DD). Null = no due date.
  dueDate              String?
  note                 String?
  createdAt            DateTime             @default(now())
  ledgerEntries        LoanLedgerEntry[]
  repayments           LoanRepayment[]
  accountLedgerEntries AccountLedgerEntry[]

  @@index([disbursedAt])
  @@index([dueDate])
  @@map("loans")
}

/// Immutable loan ledger. Outstanding = DISBURSEMENT + CHARGE - REPAYMENT.
/// `loanRepaymentId` is set on REPAYMENT entries only (source exclusivity).
model LoanLedgerEntry {
  id              String              @id @default(cuid())
  loanId          String
  type            LoanLedgerEntryType
  amountKobo      BigInt
  loanRepaymentId String?
  reversesEntryId String?
  note            String?
  occurredAt      DateTime            @default(now())
  loan            Loan                @relation(fields: [loanId], references: [id], onDelete: Restrict)
  loanRepayment   LoanRepayment?      @relation(fields: [loanRepaymentId], references: [id], onDelete: Restrict)
  reversesEntry   LoanLedgerEntry?    @relation("LoanLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      LoanLedgerEntry[]   @relation("LoanLedgerReversals")

  @@index([loanId, occurredAt])
  @@index([loanRepaymentId])
  @@index([reversesEntryId])
  @@map("loan_ledger_entries")
}

/// One repayment. `interestPortionKobo` drives a linked `LOAN_INTEREST`
/// expense; that expense is reached through `expense` (the reverse side of
/// `Expense.loanRepaymentId`), which is the only remaining direction of the
/// link.
model LoanRepayment {
  id                   String               @id @default(cuid())
  loanId               String
  amountKobo           BigInt
  interestPortionKobo  BigInt               @default(0)
  note                 String?
  paidAt               DateTime             @default(now())
  createdAt            DateTime             @default(now())
  loan                 Loan                 @relation(fields: [loanId], references: [id], onDelete: Restrict)
  ledgerEntries        LoanLedgerEntry[]
  expense              Expense?
  accountLedgerEntries AccountLedgerEntry[]

  @@index([loanId, paidAt])
  @@map("loan_repayments")
}

// =====================================================================
// Cash
// =====================================================================

/// Immutable manual cash/bank balance. The latest row by `asOfDate` then
/// `createdAt` is the balance used in financial-position calculations.
model CashSnapshot {
  id         String   @id @default(cuid())
  /// Lagos business date (YYYY-MM-DD).
  asOfDate   String
  amountKobo BigInt
  note       String?
  createdAt  DateTime @default(now())

  @@index([asOfDate])
  @@map("cash_snapshots")
}
