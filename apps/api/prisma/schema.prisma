generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductCategory {
  BEER
  SOFT_DRINK
  OTHER
}

enum Unit {
  UNIT
  PACK
}

enum StockLocation {
  WAREHOUSE
  RETAIL_SHELF
  MARKET
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum TransferDirection {
  IN
  OUT
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  VOIDED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  POS
}

enum CustomerType {
  WHOLESALE
  RETAIL
}

enum CustomerLedgerEntryType {
  SALE
  PAYMENT
  RETURN
  CUSTOMER_REFUND
  ADJUSTMENT
}

enum SupplierLedgerEntryType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
}

enum AccountType {
  CASH
  BANK
  POS
}

enum AccountEntryType {
  SALE_PAYMENT
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE
  CUSTOMER_REFUND
  TRANSFER_IN
  TRANSFER_OUT
  OWNER_CAPITAL
  OWNER_DRAWING
  OTHER_INCOME
  BANK_OR_POS_CHARGE
  ADJUSTMENT
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

enum StockAdjustmentStatus {
  COMPLETED
  VOIDED
}

// All money fields are integer kobo. Convert to naira only for display.
// Customer ledger amounts are signed: SALE +, PAYMENT -, RETURN -,
// CUSTOMER_REFUND +. A customer refund increases the customer's balance owed.
// Supplier ledger amounts are signed: PURCHASE +, PAYMENT -.
// Account ledger amounts are signed: money in +, money out -, including
// CUSTOMER_REFUND as money out.
//
// Partial unique indexes, sign/source CHECK constraints, and immutable-ledger
// triggers are intentionally installed by hand-written SQL migrations. No
// migration is created or applied as part of this schema update.
model AdminUser {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchases          Purchase[]
  sales              Sale[]
  stockTransfers     StockTransfer[]
  stockAdjustments   StockAdjustment[]
  auditLogs          AuditLog[]

  @@map("admin_users")
}

model Product {
  id                 String                @id @default(cuid())
  name               String
  sku                String?
  category           ProductCategory
  packName           String                @default("crate")
  unitsPerPack       Int
  retailPriceKobo    BigInt
  wholesalePriceKobo BigInt
  averageCostKobo    BigInt                @default(0)
  reorderLevelUnits  Int                   @default(0)
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  purchaseLines      PurchaseLine[]
  saleLines          SaleLine[]
  stockMovements     StockMovement[]
  transferLines      StockTransferLine[]
  adjustmentLines    StockAdjustmentLine[]
  returnLines        SaleReturnLine[]

  // A matching partial unique index on (sku) WHERE deletedAt IS NULL is
  // created in a hand-written SQL migration; Prisma cannot express it here.
  @@index([sku])
  @@index([name])
  @@index([deletedAt])
  @@map("products")
}

model Supplier {
  id                 String                @id @default(cuid())
  name               String
  phone              String?
  email              String?
  address            String?
  notes              String?
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  purchases          Purchase[]
  payments           SupplierPayment[]
  ledgerEntries      SupplierLedgerEntry[]

  @@index([name])
  @@index([deletedAt])
  @@map("suppliers")
}

model Customer {
  id              String                @id @default(cuid())
  name            String
  type            CustomerType          @default(RETAIL)
  creditLimitKobo BigInt                @default(0)
  phone           String?
  email           String?
  address         String?
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sales           Sale[]
  payments        CustomerPayment[]
  ledgerEntries   CustomerLedgerEntry[]
  returns         SaleReturn[]
  refunds         CustomerRefund[]

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

model Purchase {
  id                    String                @id @default(cuid())
  supplierId            String?
  createdById           String
  status                PurchaseStatus        @default(DRAFT)
  reference             String?               @unique
  notes                 String?
  totalKobo             BigInt                @default(0)
  purchasedAt           DateTime              @default(now())
  receivedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  supplier              Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy             AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines                 PurchaseLine[]
  supplierLedgerEntries SupplierLedgerEntry[]

  @@index([purchasedAt])
  @@index([supplierId, purchasedAt])
  @@map("purchases")
}

model PurchaseLine {
  id                   String          @id @default(cuid())
  purchaseId           String
  productId            String
  unit                 Unit
  quantity             Int
  unitsPerPackSnapshot Int
  quantityUnits        Int
  unitCostKobo         BigInt
  lineTotalKobo        BigInt
  purchase             Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]

  @@index([productId])
  @@map("purchase_lines")
}

model StockTransfer {
  id            String              @id @default(cuid())
  createdById   String
  from          StockLocation
  to            StockLocation
  reason        String?
  transferredAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  createdBy     AdminUser           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         StockTransferLine[]

  @@index([transferredAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id            String             @id @default(cuid())
  transferId    String
  productId     String
  quantityUnits Int
  transfer      StockTransfer      @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  movementLegs  StockTransferLeg[]

  @@index([productId])
  @@map("stock_transfer_lines")
}

// A transfer has separate IN and OUT legs so each immutable stock movement
// has exactly one uniquely attributable source row.
model StockTransferLeg {
  id             String            @id @default(cuid())
  transferLineId String
  location       StockLocation
  direction      TransferDirection
  transferLine   StockTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([transferLineId, direction])
  @@map("stock_transfer_legs")
}

model StockAdjustment {
  id          String                @id @default(cuid())
  createdById String
  reason      String
  status      StockAdjustmentStatus @default(COMPLETED)
  adjustedAt  DateTime              @default(now())
  createdAt   DateTime              @default(now())
  createdBy   AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines       StockAdjustmentLine[]

  @@index([adjustedAt])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                 String          @id @default(cuid())
  adjustmentId       String
  productId          String
  location           StockLocation
  quantityDeltaUnits Int
  unitCostKobo       BigInt
  reason             String?
  adjustment         StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements     StockMovement[]

  @@index([productId, location])
  @@map("stock_adjustment_lines")
}

model StockMovement {
  id               String               @id @default(cuid())
  productId        String
  location         StockLocation
  type             StockMovementType
  quantityUnits    Int
  unitCostKobo     BigInt
  purchaseLineId   String?
  saleLineId       String?
  transferLegId    String?
  adjustmentLineId String?
  returnLineId     String?
  reversesEntryId  String?
  occurredAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseLine     PurchaseLine?        @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  saleLine         SaleLine?            @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  transferLeg      StockTransferLeg?    @relation(fields: [transferLegId], references: [id], onDelete: Restrict)
  adjustmentLine   StockAdjustmentLine? @relation(fields: [adjustmentLineId], references: [id], onDelete: Restrict)
  returnLine       SaleReturnLine?      @relation(fields: [returnLineId], references: [id], onDelete: Restrict)
  reversesEntry    StockMovement?       @relation("StockMovementReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy       StockMovement[]      @relation("StockMovementReversals")

  @@index([productId, location, occurredAt])
  @@index([type, occurredAt])
  @@index([purchaseLineId])
  @@index([saleLineId])
  @@index([transferLegId])
  @@index([adjustmentLineId])
  @@index([returnLineId])
  @@index([reversesEntryId])
  @@map("stock_movements")
}

model Sale {
  id                    String                @id @default(cuid())
  createdById           String
  customerId            String?
  status                SaleStatus            @default(DRAFT)
  reference             String?               @unique
  notes                 String?
  discountKobo          BigInt                @default(0)
  totalKobo             BigInt                @default(0)
  soldAt                DateTime              @default(now())
  completedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdBy             AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines                 SaleLine[]
  payments              SalePayment[]
  customerLedgerEntries CustomerLedgerEntry[]
  returns               SaleReturn[]

  // At completion, payment total must not exceed totalKobo. If it is less,
  // customerId is required. This is a transactional service rule, not a
  // database-wide constraint because a draft can be incomplete.
  @@index([soldAt])
  @@index([customerId, soldAt])
  @@map("sales")
}

model SaleLine {
  id                   String           @id @default(cuid())
  saleId               String
  productId            String
  location             StockLocation
  unit                 Unit
  quantity             Int
  unitsPerPackSnapshot Int
  quantityUnits        Int
  unitPriceKobo        BigInt
  costPerUnitKobo      BigInt
  lineTotalKobo        BigInt
  sale                 Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product              Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]
  saleReturnLines      SaleReturnLine[]

  @@index([productId, saleId])
  @@map("sale_lines")
}

model SalePayment {
  id                    String                @id @default(cuid())
  saleId                String
  accountId             String
  method                PaymentMethod
  amountKobo            BigInt
  status                PaymentStatus         @default(COMPLETED)
  voidedAt              DateTime?
  paidAt                DateTime              @default(now())
  sale                  Sale                  @relation(fields: [saleId], references: [id], onDelete: Restrict)
  account               Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customerLedgerEntries CustomerLedgerEntry[]
  accountLedgerEntries  AccountLedgerEntry[]

  @@index([saleId, paidAt])
  @@index([accountId, paidAt])
  @@map("sale_payments")
}

model CustomerPayment {
  id                   String                @id @default(cuid())
  customerId           String
  accountId            String
  method               PaymentMethod
  amountKobo           BigInt
  status               PaymentStatus         @default(COMPLETED)
  voidedAt             DateTime?
  notes                String?
  paidAt               DateTime              @default(now())
  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntries        CustomerLedgerEntry[]
  accountLedgerEntries AccountLedgerEntry[]

  @@index([customerId, paidAt])
  @@index([accountId, paidAt])
  @@map("customer_payments")
}

// A reversal row has the same type and source ids as the original, and the
// exact negated amount; reversesEntryId points to that original. Each row can
// be reversed at most once, and a reversal cannot itself be reversed.
model CustomerLedgerEntry {
  id                String                  @id @default(cuid())
  customerId        String
  type              CustomerLedgerEntryType
  amountKobo        BigInt
  saleId            String?
  salePaymentId     String?
  customerPaymentId String?
  saleReturnId      String?
  customerRefundId  String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime                @default(now())
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale              Sale?                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  salePayment       SalePayment?            @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  customerPayment   CustomerPayment?        @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  saleReturn        SaleReturn?             @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  customerRefund    CustomerRefund?         @relation(fields: [customerRefundId], references: [id], onDelete: Restrict)
  reversesEntry     CustomerLedgerEntry?    @relation("CustomerLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        CustomerLedgerEntry[]   @relation("CustomerLedgerReversals")

  // Debtor aging is computed at query time by applying payments to the
  // customer's oldest unpaid sales first. No payment-allocation table exists.
  @@index([customerId, occurredAt])
  @@index([saleId])
  @@index([salePaymentId])
  @@index([customerPaymentId])
  @@index([saleReturnId])
  @@index([customerRefundId])
  @@index([reversesEntryId])
  @@map("customer_ledger_entries")
}

model SupplierPayment {
  id                   String                @id @default(cuid())
  supplierId           String
  accountId            String
  method               PaymentMethod
  amountKobo           BigInt
  status               PaymentStatus         @default(COMPLETED)
  voidedAt             DateTime?
  notes                String?
  paidAt               DateTime              @default(now())
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntries        SupplierLedgerEntry[]
  accountLedgerEntries AccountLedgerEntry[]

  @@index([supplierId, paidAt])
  @@index([accountId, paidAt])
  @@map("supplier_payments")
}

// Reversal convention: keep type and source ids, negate amount exactly, and
// set reversesEntryId to the original. A row can be reversed once only; a
// reversal cannot itself be reversed.
model SupplierLedgerEntry {
  id                String                  @id @default(cuid())
  supplierId        String
  type              SupplierLedgerEntryType
  amountKobo        BigInt
  purchaseId        String?
  supplierPaymentId String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime                @default(now())
  supplier          Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase          Purchase?               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplierPayment   SupplierPayment?        @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  reversesEntry     SupplierLedgerEntry?    @relation("SupplierLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        SupplierLedgerEntry[]   @relation("SupplierLedgerReversals")

  @@index([supplierId, occurredAt])
  @@index([purchaseId])
  @@index([supplierPaymentId])
  @@index([reversesEntryId])
  @@map("supplier_ledger_entries")
}

model Account {
  id                String               @id @default(cuid())
  name              String
  type              AccountType
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  entries           AccountLedgerEntry[]
  salePayments      SalePayment[]
  customerPayments  CustomerPayment[]
  supplierPayments  SupplierPayment[]
  expenses          Expense[]
  dailyClosings     DailyClosing[]
  outgoingTransfers AccountTransfer[]    @relation("AccountTransferFrom")
  incomingTransfers AccountTransfer[]    @relation("AccountTransferTo")
  otherIncome       OtherIncome[]
  customerRefunds   CustomerRefund[]

  @@index([deletedAt, type])
  @@map("accounts")
}

// Reversal convention: keep type and source ids, negate amount exactly, and
// set reversesEntryId to the original. A row can be reversed once only; a
// reversal cannot itself be reversed.
model AccountLedgerEntry {
  id                String               @id @default(cuid())
  accountId         String
  type              AccountEntryType
  amountKobo        BigInt
  salePaymentId     String?
  customerPaymentId String?
  supplierPaymentId String?
  expenseId         String?
  otherIncomeId     String?
  accountTransferId String?
  customerRefundId  String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime             @default(now())
  account           Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  salePayment       SalePayment?         @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  customerPayment   CustomerPayment?     @relation(fields: [customerPaymentId], references: [id], onDelete: Restrict)
  supplierPayment   SupplierPayment?     @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  expense           Expense?             @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  otherIncome       OtherIncome?         @relation(fields: [otherIncomeId], references: [id], onDelete: Restrict)
  accountTransfer   AccountTransfer?     @relation(fields: [accountTransferId], references: [id], onDelete: Restrict)
  customerRefund    CustomerRefund?      @relation(fields: [customerRefundId], references: [id], onDelete: Restrict)
  reversesEntry     AccountLedgerEntry?  @relation("AccountLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        AccountLedgerEntry[] @relation("AccountLedgerReversals")

  @@index([accountId, occurredAt])
  @@index([salePaymentId])
  @@index([customerPaymentId])
  @@index([supplierPaymentId])
  @@index([expenseId])
  @@index([otherIncomeId])
  @@index([accountTransferId])
  @@index([customerRefundId])
  @@index([reversesEntryId])
  @@map("account_ledger_entries")
}

model AccountTransfer {
  id            String               @id @default(cuid())
  fromAccountId String
  toAccountId   String
  amountKobo    BigInt
  reference     String?
  notes         String?
  transferredAt DateTime             @default(now())
  fromAccount   Account              @relation("AccountTransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account              @relation("AccountTransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  ledgerEntries AccountLedgerEntry[]

  @@index([transferredAt])
  @@map("account_transfers")
}

model OtherIncome {
  id            String               @id @default(cuid())
  accountId     String
  amountKobo    BigInt
  description   String
  receivedAt    DateTime             @default(now())
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntries AccountLedgerEntry[]

  @@index([receivedAt])
  @@map("other_income")
}

model CustomerRefund {
  id                    String                @id @default(cuid())
  customerId            String
  accountId             String
  saleReturnId          String?
  amountKobo            BigInt
  method                PaymentMethod
  voidedAt              DateTime?
  refundedAt            DateTime              @default(now())
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  account               Account               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  saleReturn            SaleReturn?           @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  customerLedgerEntries CustomerLedgerEntry[]
  accountLedgerEntries  AccountLedgerEntry[]

  @@index([customerId, refundedAt])
  @@index([accountId, refundedAt])
  @@map("customer_refunds")
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id            String               @id @default(cuid())
  categoryId    String
  accountId     String
  amountKobo    BigInt
  description   String
  voidedAt      DateTime?
  spentAt       DateTime             @default(now())
  createdAt     DateTime             @default(now())
  category      ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account       Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntries AccountLedgerEntry[]

  @@index([spentAt])
  @@index([categoryId, spentAt])
  @@map("expenses")
}

model DailyClosing {
  id                 String   @id @default(cuid())
  accountId          String
  businessDate       DateTime @db.Date
  expectedAmountKobo BigInt
  countedAmountKobo  BigInt
  varianceKobo       BigInt
  notes              String?
  closedAt           DateTime @default(now())
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  // Compute businessDate in Africa/Lagos before persistence; do not derive it
  // from a UTC date. Reports must apply the same timezone rule.
  @@unique([accountId, businessDate])
  @@index([businessDate])
  @@map("daily_closings")
}

model SaleReturn {
  id                    String                @id @default(cuid())
  saleId                String?
  customerId            String?
  reason                String
  returnedAt            DateTime              @default(now())
  createdAt             DateTime              @default(now())
  sale                  Sale?                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines                 SaleReturnLine[]
  customerLedgerEntries CustomerLedgerEntry[]
  refunds               CustomerRefund[]

  @@index([returnedAt])
  @@map("sale_returns")
}

model SaleReturnLine {
  id                   String          @id @default(cuid())
  saleReturnId         String
  saleLineId           String?
  productId            String
  location             StockLocation
  unit                 Unit
  quantity             Int
  unitsPerPackSnapshot Int
  quantityUnits        Int
  unitPriceKobo        BigInt
  costPerUnitKobo      BigInt
  restock              Boolean         @default(true)
  saleReturn           SaleReturn      @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  saleLine             SaleLine?       @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]

  // When restock is false, create a loss ADJUSTMENT movement at the current
  // product average cost; do not create a positive RETURN movement.
  @@index([productId])
  @@index([saleLineId])
  @@map("sale_return_lines")
}

model Counter {
  name      String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt

  // Invoice and purchase references are allocated atomically in the same
  // transaction as the corresponding document.
  @@map("counters")
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  metadata   Json?
  occurredAt DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("audit_logs")
}
