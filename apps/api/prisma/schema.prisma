// Fabtyna Stores — canonical database schema.
//
// Source of truth for this schema is the running application, not the original
// plan document: `packages/shared/src/domain/types.ts` (domain model) plus the
// Zod DTOs in `packages/shared/src/schemas/**` and the 23 collections in
// `apps/web/lib/api/mock-store.ts`.
//
// Conventions
//   * All money is integer kobo (`BigInt`). DTOs expose them as integer strings.
//   * All timestamps are `DateTime` (timestamptz). Business dates that the app
//     stores as a `YYYY-MM-DD` string (a Lagos business date produced by
//     `getLagosBusinessDate()`) are stored as `String` so they round-trip
//     without a timezone shift.
//   * Ledgers (stock movements, customer/supplier/account ledgers, loan ledger,
//     payments, cash snapshots) are append-only. Corrections are new reversal
//     rows linked through `reversesEntryId`.
//   * Sign conventions, source exclusivity, reversal uniqueness, immutability,
//     value sanity and the credit/lifecycle rules are enforced by hand-written
//     SQL that lives *inside* the Prisma migration history
//     (`apps/api/prisma/migrations/**`). Prisma cannot express CHECK
//     constraints, partial unique indexes, triggers or status transitions, so
//     those are authored by hand in the migration folders.
//   * THE MIGRATIONS ARE THE SINGLE SOURCE OF TRUTH for the database. There is
//     no `sql-drafts/` folder: every constraint, index and trigger that used to
//     live there has been folded into a named migration. See
//     `docs/backend-schema.md` for the full inventory.
//
// Deliberate additions beyond the current frontend model (see audit report):
//   * `Account` / `AccountLedgerEntry` / `AccountType` and the `accountId`
//     column on payments — retained by explicit decision.
//   * Some ledger rows carry nullable source columns whose target entity is not
//     modelled yet (`customerPaymentId`, `saleReturnId`, `customerRefundId`,
//     `otherIncomeId`, `accountTransferId`, `returnLineId`). They are kept as
//     plain nullable columns, without relations, so the persisted shape matches
//     the shared DTOs.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// The connection string is deliberately NOT declared in this datasource block.
// Prisma 7 resolves it per command: schema/migration commands read
// `DIRECT_URL` from `prisma.config.ts` (direct Neon connection, bypassing the
// pooler), while the runtime client gets the pooled `DATABASE_URL` through its
// driver adapter (see `src/lib/prisma.ts`).
datasource db {
  provider = "postgresql"
}

// =====================================================================
// Enums — values mirror `packages/shared/src/domain/types.ts`
// =====================================================================

enum ProductCategory {
  BEER
  SOFT_DRINK
  OTHER
}

/// How a product may be sold. `BOTH` is valid on a product; a *sale* must be
/// RETAIL or WHOLESALE only (enforced in the sales check constraint).
enum SaleChannel {
  RETAIL
  WHOLESALE
  BOTH
}

enum Unit {
  UNIT
  PACK
}

enum StockLocation {
  WAREHOUSE
  RETAIL_SHELF
  MARKET
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum TransferDirection {
  IN
  OUT
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  VOIDED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  VOIDED
}

/// How money physically left/entered the business (app value set).
enum PaymentMethod {
  CASH
  TRANSFER
  OTHER
}

enum CustomerType {
  WHOLESALE
  RETAIL
}

enum CustomerLedgerEntryType {
  SALE
  PAYMENT
  RETURN
  CUSTOMER_REFUND
  ADJUSTMENT
}

enum SupplierLedgerEntryType {
  PURCHASE
  PAYMENT
  ADJUSTMENT
}

/// Retained for the account subsystem. Not present in the frontend model yet.
enum AccountType {
  CASH
  BANK
  POS
}

enum AccountEntryType {
  SALE_PAYMENT
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
  EXPENSE
  CUSTOMER_REFUND
  TRANSFER_IN
  TRANSFER_OUT
  OWNER_CAPITAL
  OWNER_DRAWING
  OTHER_INCOME
  BANK_OR_POS_CHARGE
  ADJUSTMENT
}

enum StockAdjustmentStatus {
  COMPLETED
  VOIDED
}

enum ExpenseCategory {
  RENT
  UTILITY
  SALARY
  TRANSPORT
  MAINTENANCE
  SUPPLIES
  MARKETING
  LOAN_INTEREST
  OTHER
}

enum LoanLedgerEntryType {
  DISBURSEMENT
  CHARGE
  REPAYMENT
}

/// Who an admin user is. **NOT ENFORCED ANYWHERE YET.** There is no
/// authorization layer: nothing reads this column, so every account still has
/// full access. It exists so that when roles are wired up there is a value to
/// read. `OWNER` is the first account created by `db:seed:admin`; `STAFF` is
/// anyone added later with `--additional`, and the column default.
enum AdminRole {
  OWNER
  STAFF
}

// =====================================================================
// Identity and audit
// =====================================================================

model AdminUser {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  /// Not enforced anywhere yet — see the `AdminRole` comment above.
  role             AdminRole         @default(STAFF)
  /// Accounts are deactivated, never deleted: `Purchase`, `Sale`,
  /// `StockTransfer` and `StockAdjustment` reference this table with
  /// `onDelete: Restrict`, so a hard delete would strip the actor from history.
  isActive         Boolean           @default(true)
  /// Last successful sign-in. Null until sign-in is implemented. Stored as
  /// `timestamptz` per the documented convention
  /// (`docs/backend-schema.md` §1); note it is the *only* `timestamptz` column
  /// so far — every other timestamp column is `timestamp(3)`.
  lastLoginAt      DateTime?         @db.Timestamptz(3)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchases        Purchase[]
  sales            Sale[]
  stockTransfers   StockTransfer[]
  stockAdjustments StockAdjustment[]
  auditLogs        AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  metadata   Json?
  occurredAt DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@map("audit_logs")
}

// =====================================================================
// Catalogue and parties
// =====================================================================

model Product {
  id                 String                @id @default(cuid())
  name               String
  sku                String?
  category           ProductCategory
  packName           String                @default("crate")
  unitsPerPack       Int
  /// Which shelf/price list this product is sellable from.
  saleChannel        SaleChannel           @default(BOTH)
  retailPriceKobo    BigInt
  wholesalePriceKobo BigInt
  averageCostKobo    BigInt                @default(0)
  reorderLevelUnits  Int                   @default(0)
  deletedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  purchaseLines      PurchaseLine[]
  saleLines          SaleLine[]
  stockMovements     StockMovement[]
  transferLines      StockTransferLine[]
  adjustmentLines    StockAdjustmentLine[]

  // Partial unique index on (sku) WHERE deletedAt IS NULL and the
  // `sku = upper(trim(sku))` CHECK live in the hand-written SQL migrations;
  // Prisma cannot express either here.
  @@index([sku])
  @@index([name])
  @@index([deletedAt])
  @@map("products")
}

model Supplier {
  id            String                @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  purchases     Purchase[]
  payments      SupplierPayment[]
  ledgerEntries SupplierLedgerEntry[]

  @@index([name])
  @@index([deletedAt])
  @@map("suppliers")
}

model Customer {
  id              String                @id @default(cuid())
  name            String
  type            CustomerType          @default(RETAIL)
  creditLimitKobo BigInt                @default(0)
  phone           String?
  email           String?
  address         String?
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  sales           Sale[]
  ledgerEntries   CustomerLedgerEntry[]

  @@index([name])
  @@index([phone])
  @@index([deletedAt])
  @@map("customers")
}

// =====================================================================
// Purchases (supplier credit / payables)
// =====================================================================

model Purchase {
  id                    String                @id @default(cuid())
  supplierId            String?
  createdById           String
  status                PurchaseStatus        @default(DRAFT)
  reference             String?               @unique
  notes                 String?
  totalKobo             BigInt                @default(0)
  /// Amount already paid to the supplier. Denormalised from `SupplierPayment`
  /// rows for cheap list rendering. No trigger keeps this in step: the payment
  /// service owns it and the drift-audit query in
  /// `20261017000500_value_checks` proves there is no gap.
  paidKobo              BigInt                @default(0)
  /// Lagos business date (YYYY-MM-DD) the balance becomes overdue. Null = none.
  dueDate               String?
  purchasedAt           DateTime              @default(now())
  receivedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  supplier              Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy             AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines                 PurchaseLine[]
  payments              SupplierPayment[]
  supplierLedgerEntries SupplierLedgerEntry[]

  // Hand-written SQL, not Prisma constraints:
  //   * `paidKobo <= totalKobo` (migration `20261017000500_value_checks`);
  //   * `paidKobo < totalKobo` requires `supplierId IS NOT NULL` (migration
  //     `20261017000700_sale_purchase_rules`), mirroring createPurchase().
  @@index([purchasedAt])
  @@index([supplierId, purchasedAt])
  @@index([dueDate])
  @@map("purchases")
}

model PurchaseLine {
  id                   String          @id @default(cuid())
  purchaseId           String
  productId            String
  unit                 Unit
  quantity             Int
  unitsPerPackSnapshot Int
  quantityUnits        Int
  unitCostKobo         BigInt
  lineTotalKobo        BigInt
  purchase             Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]

  @@index([productId])
  @@map("purchase_lines")
}

/// Immutable record of one payment made to a supplier. Mirrors `SalePayment`.
/// The matching (negative) `SupplierLedgerEntry` references this row through
/// `supplierPaymentId`, keeping the ledger source-exclusivity invariant intact.
model SupplierPayment {
  id                   String                @id @default(cuid())
  supplierId           String
  purchaseId           String
  accountId            String?
  method               PaymentMethod
  amountKobo           BigInt
  note                 String?
  paidAt               DateTime              @default(now())
  createdAt            DateTime              @default(now())
  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase             Purchase              @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  account              Account?              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  ledgerEntries        SupplierLedgerEntry[]
  accountLedgerEntries AccountLedgerEntry[]

  @@index([supplierId, paidAt])
  @@index([purchaseId, paidAt])
  @@index([accountId, paidAt])
  @@map("supplier_payments")
}

/// Reversal convention: keep type and source ids, negate the amount exactly,
/// and set `reversesEntryId` to the original. A row can be reversed once only;
/// a reversal cannot itself be reversed. Signed: PURCHASE +, PAYMENT -.
model SupplierLedgerEntry {
  id                String                  @id @default(cuid())
  supplierId        String
  type              SupplierLedgerEntryType
  amountKobo        BigInt
  purchaseId        String?
  supplierPaymentId String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime                @default(now())
  supplier          Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase          Purchase?               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  supplierPayment   SupplierPayment?        @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  reversesEntry     SupplierLedgerEntry?    @relation("SupplierLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        SupplierLedgerEntry[]   @relation("SupplierLedgerReversals")

  @@index([supplierId, occurredAt])
  @@index([purchaseId])
  @@index([supplierPaymentId])
  @@index([reversesEntryId])
  @@map("supplier_ledger_entries")
}

// =====================================================================
// Stock
// =====================================================================

model StockTransfer {
  id            String              @id @default(cuid())
  createdById   String
  from          StockLocation
  to            StockLocation
  reason        String?
  reference     String?             @unique
  transferredAt DateTime            @default(now())
  createdAt     DateTime            @default(now())
  createdBy     AdminUser           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines         StockTransferLine[]

  // `from <> to` is a hand-written CHECK constraint.
  @@index([transferredAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id            String             @id @default(cuid())
  transferId    String
  productId     String
  quantityUnits Int
  transfer      StockTransfer      @relation(fields: [transferId], references: [id], onDelete: Restrict)
  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  movementLegs  StockTransferLeg[]

  @@index([productId])
  @@map("stock_transfer_lines")
}

/// A transfer has separate IN and OUT legs so each immutable stock movement has
/// exactly one uniquely attributable source row.
model StockTransferLeg {
  id             String            @id @default(cuid())
  transferLineId String
  location       StockLocation
  direction      TransferDirection
  transferLine   StockTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]

  @@unique([transferLineId, direction])
  @@map("stock_transfer_legs")
}

model StockAdjustment {
  id          String                @id @default(cuid())
  createdById String
  reason      String
  status      StockAdjustmentStatus @default(COMPLETED)
  adjustedAt  DateTime              @default(now())
  createdAt   DateTime              @default(now())
  createdBy   AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines       StockAdjustmentLine[]

  @@index([adjustedAt])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id                 String          @id @default(cuid())
  adjustmentId       String
  productId          String
  location           StockLocation
  quantityDeltaUnits Int
  unitCostKobo       BigInt
  reason             String?
  adjustment         StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements     StockMovement[]

  @@index([productId, location])
  @@map("stock_adjustment_lines")
}

/// One immutable stock movement. Exactly one source column must be set
/// (`returnLineId` is reserved — no return entity is modelled yet, so it is a
/// plain column without a relation). Never-negative stock is enforced in the
/// service with a row lock; single-source and sign rules are SQL CHECKs.
model StockMovement {
  id               String               @id @default(cuid())
  productId        String
  location         StockLocation
  type             StockMovementType
  quantityUnits    Int
  unitCostKobo     BigInt
  purchaseLineId   String?
  saleLineId       String?
  transferLegId    String?
  adjustmentLineId String?
  returnLineId     String?
  reversesEntryId  String?
  occurredAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaseLine     PurchaseLine?        @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  saleLine         SaleLine?            @relation(fields: [saleLineId], references: [id], onDelete: Restrict)
  transferLeg      StockTransferLeg?    @relation(fields: [transferLegId], references: [id], onDelete: Restrict)
  adjustmentLine   StockAdjustmentLine? @relation(fields: [adjustmentLineId], references: [id], onDelete: Restrict)
  reversesEntry    StockMovement?       @relation("StockMovementReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy       StockMovement[]      @relation("StockMovementReversals")

  @@index([productId, location, occurredAt])
  @@index([type, occurredAt])
  @@index([purchaseLineId])
  @@index([saleLineId])
  @@index([transferLegId])
  @@index([adjustmentLineId])
  @@index([returnLineId])
  @@index([reversesEntryId])
  @@map("stock_movements")
}

// =====================================================================
// Sales
// =====================================================================

model Sale {
  id                    String                @id @default(cuid())
  createdById           String
  customerId            String?
  /// Optional denormalised display name for ad-hoc customers. The application
  /// never populates it today — every create path (sales/new, the retail-debtor
  /// dialog) sends `null` and uses `customerId` instead. Kept nullable and
  /// untouched for the shared DTO shape.
  customerName          String?
  channel               SaleChannel
  status                SaleStatus            @default(DRAFT)
  reference             String?               @unique
  notes                 String?
  totalKobo             BigInt                @default(0)
  /// Amount already received. Denormalised from `SalePayment` rows.
  paidKobo              BigInt                @default(0)
  soldAt                DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdBy             AdminUser             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  customer              Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines                 SaleLine[]
  payments              SalePayment[]
  customerLedgerEntries CustomerLedgerEntry[]

  // Hand-written SQL, not Prisma constraints:
  //   * `channel <> 'BOTH'` and `paidKobo <= totalKobo` (migration
  //     `20261017000500_value_checks`);
  //   * `paidKobo < totalKobo` requires `customerId IS NOT NULL` (migration
  //     `20261017000700_sale_purchase_rules`), mirroring
  //     validateCompletedSalePayment();
  //   * `VOIDED` is terminal and a COMPLETED sale cannot return to DRAFT
  //     (same migration, enforced by a BEFORE UPDATE trigger).
  @@index([soldAt])
  @@index([customerId, soldAt])
  @@map("sales")
}

model SaleLine {
  id                   String          @id @default(cuid())
  saleId               String
  productId            String
  location             StockLocation
  unit                 Unit
  quantity             Int
  unitsPerPackSnapshot Int
  quantityUnits        Int
  unitPriceKobo        BigInt
  costPerUnitKobo      BigInt
  lineTotalKobo        BigInt
  sale                 Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product              Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements       StockMovement[]

  @@index([productId, saleId])
  @@map("sale_lines")
}

/// Immutable sale payment. `accountId` is retained for the account subsystem;
/// the app does not populate it yet.
model SalePayment {
  id                    String                @id @default(cuid())
  saleId                String
  accountId             String?
  amountKobo            BigInt
  paidAt                DateTime              @default(now())
  createdAt             DateTime              @default(now())
  sale                  Sale                  @relation(fields: [saleId], references: [id], onDelete: Restrict)
  account               Account?              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  customerLedgerEntries CustomerLedgerEntry[]
  accountLedgerEntries  AccountLedgerEntry[]

  @@index([saleId, paidAt])
  @@index([accountId, paidAt])
  @@map("sale_payments")
}

/// Reversal convention as for the other ledgers. Signed: SALE +, PAYMENT -,
/// RETURN -, CUSTOMER_REFUND +. Debtor aging applies payments to the oldest
/// unpaid sales at query time; there is no payment-allocation table.
///
/// `customerPaymentId`, `saleReturnId` and `customerRefundId` are reserved for
/// entities that are not modelled yet; they are plain nullable columns.
model CustomerLedgerEntry {
  id                String                  @id @default(cuid())
  customerId        String
  type              CustomerLedgerEntryType
  amountKobo        BigInt
  saleId            String?
  salePaymentId     String?
  customerPaymentId String?
  saleReturnId      String?
  customerRefundId  String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime                @default(now())
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale              Sale?                   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  salePayment       SalePayment?            @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  reversesEntry     CustomerLedgerEntry?    @relation("CustomerLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        CustomerLedgerEntry[]   @relation("CustomerLedgerReversals")

  @@index([customerId, occurredAt])
  @@index([saleId])
  @@index([salePaymentId])
  @@index([customerPaymentId])
  @@index([saleReturnId])
  @@index([customerRefundId])
  @@index([reversesEntryId])
  @@map("customer_ledger_entries")
}

// =====================================================================
// Accounts (retained subsystem; not yet wired to the frontend)
// =====================================================================

model Account {
  id               String               @id @default(cuid())
  name             String
  type             AccountType
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  entries          AccountLedgerEntry[]
  salePayments     SalePayment[]
  supplierPayments SupplierPayment[]

  @@index([deletedAt, type])
  @@map("accounts")
}

/// Reversal convention as for the other ledgers. Signed: money in +, money out
/// minus. `customerPaymentId`, `otherIncomeId`, `accountTransferId` and
/// `customerRefundId` are reserved for entities not modelled yet (plain
/// nullable columns).
model AccountLedgerEntry {
  id                String               @id @default(cuid())
  accountId         String
  type              AccountEntryType
  amountKobo        BigInt
  salePaymentId     String?
  customerPaymentId String?
  supplierPaymentId String?
  expenseId         String?
  otherIncomeId     String?
  accountTransferId String?
  customerRefundId  String?
  reversesEntryId   String?
  note              String?
  occurredAt        DateTime             @default(now())
  account           Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)
  salePayment       SalePayment?         @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)
  supplierPayment   SupplierPayment?     @relation(fields: [supplierPaymentId], references: [id], onDelete: Restrict)
  expense           Expense?             @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  reversesEntry     AccountLedgerEntry?  @relation("AccountLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy        AccountLedgerEntry[] @relation("AccountLedgerReversals")

  @@index([accountId, occurredAt])
  @@index([salePaymentId])
  @@index([customerPaymentId])
  @@index([supplierPaymentId])
  @@index([expenseId])
  @@index([otherIncomeId])
  @@index([accountTransferId])
  @@index([customerRefundId])
  @@index([reversesEntryId])
  @@map("account_ledger_entries")
}

// =====================================================================
// Expenses
// =====================================================================

/// `channel` is the shelf the cost belongs to; `BOTH` expenses are split
/// between retail and wholesale in daily-total reports. `loanRepaymentId` is
/// set when the row was generated by a loan repayment's interest portion; the
/// FK is added by the SQL migrations (Prisma cannot express the mutual
/// reference between `Expense` and `LoanRepayment` cleanly).
model Expense {
  id              String               @id @default(cuid())
  channel         SaleChannel
  category        ExpenseCategory
  description     String
  amountKobo      BigInt
  expenseDate     DateTime
  loanRepaymentId String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  ledgerEntries   AccountLedgerEntry[]

  // `amountKobo > 0` is a hand-written CHECK constraint.
  @@index([expenseDate])
  @@index([channel, expenseDate])
  @@index([category, expenseDate])
  @@map("expenses")
}

// =====================================================================
// Loans
// =====================================================================

model Loan {
  id                 String            @id @default(cuid())
  lenderName         String
  principalKobo      BigInt
  /// Total interest/fee agreed up front. May be zero.
  agreedInterestKobo BigInt            @default(0)
  disbursedAt        DateTime          @default(now())
  /// Lagos business date (YYYY-MM-DD). Null = no due date.
  dueDate            String?
  note               String?
  createdAt          DateTime          @default(now())
  ledgerEntries      LoanLedgerEntry[]
  repayments         LoanRepayment[]

  @@index([disbursedAt])
  @@index([dueDate])
  @@map("loans")
}

/// Immutable loan ledger. Outstanding = DISBURSEMENT + CHARGE - REPAYMENT.
/// `loanRepaymentId` is set on REPAYMENT entries only (source exclusivity).
model LoanLedgerEntry {
  id              String              @id @default(cuid())
  loanId          String
  type            LoanLedgerEntryType
  amountKobo      BigInt
  loanRepaymentId String?
  reversesEntryId String?
  note            String?
  occurredAt      DateTime            @default(now())
  loan            Loan                @relation(fields: [loanId], references: [id], onDelete: Restrict)
  loanRepayment   LoanRepayment?      @relation(fields: [loanRepaymentId], references: [id], onDelete: Restrict)
  reversesEntry   LoanLedgerEntry?    @relation("LoanLedgerReversals", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy      LoanLedgerEntry[]   @relation("LoanLedgerReversals")

  @@index([loanId, occurredAt])
  @@index([loanRepaymentId])
  @@index([reversesEntryId])
  @@map("loan_ledger_entries")
}

/// One repayment. `interestPortionKobo` drives a linked `LOAN_INTEREST`
/// expense (its `expenseId`). `expenseId` and `Expense.loanRepaymentId` point
/// at each other; the FK is added by the SQL migrations.
model LoanRepayment {
  id                  String            @id @default(cuid())
  loanId              String
  amountKobo          BigInt
  interestPortionKobo BigInt            @default(0)
  expenseId           String?
  note                String?
  paidAt              DateTime          @default(now())
  createdAt           DateTime          @default(now())
  loan                Loan              @relation(fields: [loanId], references: [id], onDelete: Restrict)
  ledgerEntries       LoanLedgerEntry[]

  @@index([loanId, paidAt])
  @@index([expenseId])
  @@map("loan_repayments")
}

// =====================================================================
// Cash
// =====================================================================

/// Immutable manual cash/bank balance. The latest row by `asOfDate` then
/// `createdAt` is the balance used in financial-position calculations.
model CashSnapshot {
  id         String   @id @default(cuid())
  /// Lagos business date (YYYY-MM-DD).
  asOfDate   String
  amountKobo BigInt
  note       String?
  createdAt  DateTime @default(now())

  @@index([asOfDate])
  @@map("cash_snapshots")
}
