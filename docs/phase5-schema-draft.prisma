// Phase 5 schema draft — container deposits and stocktakes.
// These models were removed from the active schema.prisma until Phase 5
// (containers and stocktakes) begins. Re-add them to schema.prisma when
// that phase starts.

enum StocktakeStatus {
  DRAFT
  COMPLETED
  VOIDED
}

enum ContainerMovementDirection {
  IN
  OUT
}

model Stocktake {
  id          String          @id @default(cuid())
  createdById String
  status      StocktakeStatus @default(DRAFT)
  notes       String?
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  createdBy   AdminUser       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines       StocktakeLine[]

  @@index([startedAt])
  @@map("stocktakes")
}

model StocktakeLine {
  id              String          @id @default(cuid())
  stocktakeId     String
  productId       String
  location        StockLocation
  expectedUnits   Int
  countedUnits    Int
  differenceUnits Int
  stocktake       Stocktake       @relation(fields: [stocktakeId], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements  StockMovement[]

  @@unique([stocktakeId, productId, location])
  @@index([productId, location])
  @@map("stocktake_lines")
}

model ContainerType {
  id                 String              @id @default(cuid())
  productId          String
  name               String
  unit               Unit
  depositPerUnitKobo BigInt              @default(0)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements          ContainerMovement[]

  @@unique([productId, name])
  @@map("container_types")
}

model ContainerTransfer {
  id            String              @id @default(cuid())
  createdById   String
  from          StockLocation
  to            StockLocation
  transferredAt DateTime            @default(now())
  createdBy     AdminUser           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  movements     ContainerMovement[]

  @@index([transferredAt])
  @@map("container_transfers")
}

model ContainerMovement {
  id              String                     @id @default(cuid())
  containerTypeId String
  location        StockLocation
  quantity        Int
  direction       ContainerMovementDirection
  supplierId      String?
  saleId          String?
  saleReturnId    String?
  transferId      String?
  occurredAt      DateTime                   @default(now())
  containerType   ContainerType              @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  supplier        Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  sale            Sale?                      @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleReturn      SaleReturn?                @relation(fields: [saleReturnId], references: [id], onDelete: Restrict)
  transfer        ContainerTransfer?         @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([containerTypeId, location, occurredAt])
  @@index([supplierId])
  @@map("container_movements")
}
