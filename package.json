{
  "name": "fabtyna-stores",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm --filter @fabtyna/web build",
    "dev": "pnpm --filter @fabtyna/web dev",
    "lint": "pnpm --filter @fabtyna/web lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  }
}
